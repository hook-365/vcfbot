# Copy to .env and adjust. All values are optional; defaults shown below.

# ── Inference endpoints (OpenAI-compatible) ────────────────────────────
# Single-server setups (LM Studio on Mac) just set LM_STUDIO_URL.
# Split setups (apollo runs chat + embed in separate llama.cpp servers)
# override CHAT_BASE_URL and EMBED_BASE_URL independently.
LM_STUDIO_URL=http://localhost:1234/v1
LM_STUDIO_API_KEY=lm-studio

# Uncomment when chat and embeddings live on different servers/ports.
# CHAT_BASE_URL=http://192.168.1.200:8084/v1
# EMBED_BASE_URL=http://192.168.1.200:8120/v1

# ── Models ─────────────────────────────────────────────────────────────
# Exact identifiers as the server reports them (LM Studio UI, `lms ls`,
# or `curl <url>/models`).
# Default chat: Qwen3 4B MLX (Mac dev) — bump to qwen3-8b-q8_0 on apollo.
# Default embed: nomic-embed-text-v1.5 Q8_0 (gets `search_*:` prefixes
# applied automatically; other embedders won't and may retrieve worse).
CHAT_MODEL=qwen/qwen3-4b-2507
EMBED_MODEL=text-embedding-nomic-embed-text-v1.5-embedding

# ── Storage ────────────────────────────────────────────────────────────
# Relative paths resolve against the repo root.
# PDF_DIR=data/pdfs
# CHROMA_DIR=data/chroma
# CHROMA_COLLECTION=vcfbot

# ── Retrieval + chunking knobs ─────────────────────────────────────────
# nomic-embed has n_ctx_train=2048 and VMware text tokenizes ~6-7x heavier
# in WordPiece than cl100k. TARGET_TOKENS=220 (cl100k) keeps each chunk
# safely under the 2048 nomic ceiling. Raise only if you switch to an
# embed model with a larger trained context.
# TOP_K=4
# TARGET_TOKENS=220
# OVERLAP_TOKENS=40
